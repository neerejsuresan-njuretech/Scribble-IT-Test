{
  "name": "@scribble-it/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript domain models and FastAPI v1 DTO interfaces for SCRIBBLE-IT across Web, Desktop, and Mobile clients.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./itsm": {
      "types": "./src/itsm.ts",
      "default": "./src/itsm.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
