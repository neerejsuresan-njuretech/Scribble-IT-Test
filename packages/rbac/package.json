      "default": "./src/navigationAccess.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./src/permissions.ts"
    }
  },
  "dependencies": {
    "@scribble-it/types": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
