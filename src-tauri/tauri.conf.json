{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCRIBBLE-IT",
  "mainBinaryName": "SCRIBBLE-IT",
  "version": "1.0.0",
  "identifier": "in.njuretech.scribbleit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SCRIBBLE-IT",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Njure Tech",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) Njure Tech (formally Njure Group)",
    "category": "Business",
    "shortDescription": "Enterprise IT Management. Open to Everyone.",
    "longDescription": "SCRIBBLE-IT Desktop Application (Windows, macOS & Linux) by Njure Tech for incident management, service requests, CMDB, change advisory board, and identity governance.",
    "icon": [
      "../assets/brand/icons/windows/32x32.png",
      "../assets/brand/icons/windows/128x128.png",
      "../assets/brand/icons/windows/128x128@2x.png",
      "../assets/brand/icons/windows/icon.ico",
      "../assets/brand/icons/windows/icon.png",
      "../assets/brand/icons/macos/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/metainfo/in.njuregroup.scribbleit.metainfo.xml": "../assets/brand/icons/linux/packaging/in.njuregroup.scribbleit.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/metainfo/in.njuregroup.scribbleit.metainfo.xml": "../assets/brand/icons/linux/packaging/in.njuregroup.scribbleit.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "background": "../assets/brand/icons/macos/dmg/dmg-background.png",
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 145,
          "y": 195
        },
        "applicationFolderPosition": {
          "x": 395,
          "y": 195
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../assets/brand/icons/windows/icon.ico",
        "headerImage": "../assets/brand/icons/windows/installer/nsis-header.bmp",
        "sidebarImage": "../assets/brand/icons/windows/installer/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "../assets/brand/icons/windows/installer/msi-banner.bmp",
        "dialogImagePath": "../assets/brand/icons/windows/installer/msi-dialog.bmp"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["scribbleit"]
      }
    }
  }
}
