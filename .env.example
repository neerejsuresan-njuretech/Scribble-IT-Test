# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server-Side Telephony Carrier Credentials (Twilio / Custom Bridge)
# Configure in Settings > Secrets for automated server-side two-leg mobile/PSTN bridging.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TELEPHONY_WEBHOOK_SECRET=""

# Optional GitHub Pages Static Hosting & Remote Backend Configuration
# VITE_BASE_PATH defaults to "./" during production builds for GitHub Pages subpath compatibility.
VITE_BASE_PATH="./"
# Set VITE_API_BASE_URL (e.g. http://localhost:8000 or https://api.example.com) to connect the frontend to the Scribble-IT 2.0 FastAPI backend.
VITE_API_BASE_URL=""
# Set VITE_USE_BACKEND_API="true" to activate FastAPI /api/v1/* API mode alongside VITE_API_BASE_URL.
VITE_USE_BACKEND_API="false"
# Set ALLOWED_ORIGIN on the Express backend (e.g. https://username.github.io) to allow CORS from GitHub Pages.
ALLOWED_ORIGIN=""

# ==============================================================================
# SCRIBBLE-IT 2.0 — PYTHON FASTAPI + POSTGRESQL + REDIS BACKEND FOUNDATION
# ==============================================================================
APP_ENV="development"
LOG_LEVEL="INFO"
LOG_JSON="true"
ENABLE_OPENAPI_DOCS="true"

# PostgreSQL Bootstrap & Role Separation (Never run backend with superuser role)
POSTGRES_DB="scribble_it"
POSTGRES_PORT="5432"
POSTGRES_SUPERUSER="postgres_bootstrap"
POSTGRES_SUPERUSER_PASSWORD=""
POSTGRES_MIGRATOR_USER="scribble_migrator"
POSTGRES_MIGRATOR_PASSWORD=""
POSTGRES_APP_USER="scribble_app"
POSTGRES_APP_PASSWORD=""

# Runtime DSN (restricted NOSUPERUSER / NOBYPASSRLS role) & Migration DSN (Alembic only)
DATABASE_URL="postgresql+asyncpg://scribble_app:<APP_PASSWORD>@localhost:5432/scribble_it"
MIGRATION_DATABASE_URL="postgresql+psycopg://scribble_migrator:<MIGRATOR_PASSWORD>@localhost:5432/scribble_it"

# Redis Cache & Worker Broker
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379/0"

# Backend Server, CORS & Auth Secrets
BACKEND_PORT="8000"
WEB_PORT="8080"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="14"

# AI & External Integrations Security (Backend-Only — NEVER expose in VITE_* vars)
GEMINI_MODEL="gemini-4-hydrogen"
AI_RATE_LIMIT_PER_MINUTE="20"
AI_DAILY_ORG_LIMIT="500"
INTEGRATION_ENCRYPTION_KEY=""
API_RATE_LIMIT_PER_MINUTE="300"
WEBHOOK_REPLAY_WINDOW_SECONDS="300"

# Attachment Upload Storage
UPLOAD_STORAGE_DIR="/var/lib/scribble-it/uploads"
MAX_UPLOAD_BYTES="10485760"

# Phase 5.3: Native Desktop (Tauri) & Mobile (React Native) Backend Configuration
DEPLOYMENT_MODE="cloud"
INSTANCE_NAME="Scribble-IT Enterprise"
PUBLIC_API_URL=""
ALLOW_TAURI_WEBVIEW_ORIGINS="false"
ALLOWED_NATIVE_APP_IDS=""
MIN_DESKTOP_APP_VERSION="1.0.0"
MIN_MOBILE_APP_VERSION="1.0.0"

# Phase 5.3: Push Notification Providers (Backend-Only — NEVER expose to web/desktop/mobile clients)
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_BUNDLE_ID=""
APNS_PRIVATE_KEY=""
APNS_USE_SANDBOX="false"
