{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@scribble-it/types": ["./packages/types/src/index.ts"],
      "@scribble-it/types/*": ["./packages/types/src/*"],
      "@scribble-it/api-client": ["./packages/api-client/src/index.ts"],
      "@scribble-it/api-client/*": ["./packages/api-client/src/*"],
      "@scribble-it/rbac": ["./packages/rbac/src/index.ts"],
      "@scribble-it/rbac/*": ["./packages/rbac/src/*"],
      "@scribble-it/design-tokens": ["./packages/design-tokens/src/index.ts"],
      "@scribble-it/design-tokens/*": ["./packages/design-tokens/src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist", "src-tauri/target"]
}
